# Empty Supabase variables use local SQLite. Use your own project for a deployment.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
PORT=5180
HOST=127.0.0.1
# For deployed servers, set the external HTTPS origin and HOST=0.0.0.0.
APP_ORIGIN=
TRUST_PROXY=0
# Optional OpenAI-compatible model (server-side only).
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# Personal connectors are restricted to this workspace key's SHA-256 hash.
INTEGRATION_OWNER_HASH=
ZOTERO_USER_ID=
ZOTERO_API_KEY=
MCP_SERVERS=[]
MCP_ALLOW_LOCAL=false
