# Empty Supabase variables use local SQLite. Use your own project for a deployment.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
PORT=5180
HOST=127.0.0.1
# For deployed servers, set the external HTTPS origin and HOST=0.0.0.0.
APP_ORIGIN=
TRUST_PROXY=0
# Optional AI connection (server-side only); public name is ScrapeTx Ai.
# Use google for the native generateContent API, or openai-compatible.
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# Optional Google-only alternate model, attempted only after two capacity (503) errors.
AI_FALLBACK_MODEL=
# SerpAPI/Zotero/Mendeley: connect in the Integrations UI; credentials use the
# private server-local vault in .data/. Keep that directory persistent.
# Owner-only MCP and legacy Zotero browse use the settings below.
INTEGRATION_OWNER_HASH=
ZOTERO_USER_ID=
ZOTERO_API_KEY=
MCP_SERVERS=[]
MCP_ALLOW_LOCAL=false
